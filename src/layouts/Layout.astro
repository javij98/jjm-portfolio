---
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import CommandMenu from "../components/CommandMenu";
import type { Locale, SiteContent } from "../i18n/content";
import { BLOG_ENABLED } from "../config/site";

interface Props {
  lang: Locale;
  content: SiteContent;
  currentPath: string;
  pageTitle?: string;
  pageDescription?: string;
  article?: boolean;
}

const { lang, content, currentPath, pageTitle, pageDescription, article = false } = Astro.props;
const title = pageTitle ? `${pageTitle} | ${content.profile.name}` : `${content.profile.name} | ${content.profile.role}`;
const description = pageDescription ?? content.profile.introduction;
const baseUrl = Astro.site ?? new URL("https://javier-jimenez-molina.vercel.app");
const pathSuffix = currentPath.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "";
const isHome = pathSuffix === "" || pathSuffix === "/";
const homePrefix = isHome ? "" : `/${lang}`;
const canonical = new URL(currentPath, baseUrl).toString();
const spanishUrl = new URL(`/es${pathSuffix}`, baseUrl).toString();
const englishUrl = new URL(`/en${pathSuffix}`, baseUrl).toString();
const navLinks = [
  { label: content.nav.home, href: `${homePrefix}#hero` },
  { label: content.nav.about, href: `${homePrefix}#about` },
  { label: content.nav.projects, href: isHome ? "#projects" : `/${lang}/projects` },
  { label: content.nav.experience, href: `${homePrefix}#experience` },
  { label: content.nav.skills, href: `${homePrefix}#skills` },
  { label: content.nav.education, href: `${homePrefix}#education` },
  ...(BLOG_ENABLED ? [{ label: content.nav.blog, href: `/${lang}/blog` }] : []),
  { label: content.nav.contact, href: `${homePrefix}#contact` },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ready");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080f1c" />
    <meta name="description" content={description} />
    <meta name="author" content={content.profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100">
    <a href="#main-content" class="sr-only rounded-md bg-emerald-300 px-4 py-2 text-slate-950 focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100]">{lang === "es" ? "Saltar al contenido" : "Skip to content"}</a>
    <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/90 backdrop-blur-xl">
      <nav class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-3 px-5 sm:px-6" aria-label={lang === "es" ? "Navegación principal" : "Main navigation"}>
        <a href={`${homePrefix}#hero`} class="flex shrink-0 items-center gap-2.5 rounded-md font-mono text-sm font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
          <img src="/favicon.svg" alt="" width="36" height="36" class="h-9 w-9" aria-hidden="true" />
          <span class="hidden sm:inline">Javier Jiménez Molina</span>
          <span class="sm:hidden">Javier J.</span>
        </a>

        <div class="hidden shrink-0 items-center gap-1 2xl:flex">
          {navLinks.map((link) => (
            <a href={link.href} class="nav-link whitespace-nowrap rounded-md px-2.5 py-2 text-xs font-medium text-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-300">{link.label}</a>
          ))}
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <CommandMenu client:load blogEnabled={BLOG_ENABLED} lang={lang} email={content.profile.email} linkedin={content.profile.linkedin} githubHref={content.profile.github} />
          <LanguagePicker currentLang={lang} pathname={currentPath} />
          <details class="relative 2xl:hidden" data-mobile-nav>
            <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-white/15 text-slate-200 marker:hidden hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-cyan-300" aria-label={content.nav.menu}>
              <span aria-hidden="true" class="font-mono text-lg leading-none">☰</span>
            </summary>
            <div class="absolute right-0 top-12 w-52 rounded-xl border border-white/15 bg-slate-900 p-2 shadow-2xl shadow-black/40">
              {navLinks.map((link) => (
                <a href={link.href} class="nav-link block rounded-md px-3 py-2.5 text-sm text-slate-200 focus-visible:outline-2 focus-visible:outline-cyan-300">{link.label}</a>
              ))}
            </div>
          </details>
        </div>
      </nav>
    </header>

    <main id="main-content">
      {!isHome && (
        <nav class="mx-auto max-w-6xl px-5 pt-6 sm:px-6 sm:pt-8" aria-label={lang === "es" ? "Volver a la web principal" : "Return to main site"}>
          <a href={`/${lang}`} data-back-home class="signal-hover inline-flex min-h-11 items-center gap-2 rounded-lg border border-white/15 bg-slate-900/40 px-4 py-2 font-mono text-xs text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
            <span aria-hidden="true">←</span>{lang === "es" ? "Volver al inicio" : "Back to home"}
          </a>
        </nav>
      )}
      <slot />
    </main>

    <footer class="border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-7 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <span>© {new Date().getFullYear()} {content.profile.name}</span>
        <span class="font-mono">{content.footer}</span>
      </div>
    </footer>

    <script>
      const revealTargets = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
      if (document.documentElement.classList.contains("motion-ready") && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -35px 0px" });
        revealTargets.forEach((target) => observer.observe(target));
      } else {
        document.documentElement.classList.remove("motion-ready");
      }

      const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav.open = false;
        });
      });
    </script>
  </body>
</html>
