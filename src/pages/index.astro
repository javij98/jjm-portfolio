---
import { SITE_URL } from "../config/url.mjs";
const fallbackLocalePath = "/es";
const baseUrl = Astro.site ?? new URL(SITE_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${fallbackLocalePath}`} />
    <link rel="canonical" href={new URL(fallbackLocalePath, baseUrl).href} />
    <link rel="alternate" type="text/markdown" href={new URL("/es/index.md", baseUrl).href} />
    <link rel="describedby" type="text/plain" href={new URL("/llms.txt", baseUrl).href} />
    <title>Javier Jiménez Molina | DevOps Engineer</title>
    <script is:inline>
      const browserLang = (navigator.language || "es").toLowerCase();
      const preferredLocale = browserLang.startsWith("en") ? "en" : "es";
      window.location.replace(`/${preferredLocale}`);
    </script>
  </head>
  <body>
    <a href={fallbackLocalePath}>Ir a la versión en español / Go to the Spanish version</a>
  </body>
</html>
