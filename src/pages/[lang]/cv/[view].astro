---
import Layout from "../../../layouts/Layout.astro";
import ResumeViewPicker from "../../../components/ResumeViewPicker.astro";
import Experience from "../../../components/sections/Experience.astro";
import Projects from "../../../components/sections/Projects.astro";
import Skills from "../../../components/sections/Skills.astro";
import TechnologyMarquee from "../../../components/sections/TechnologyMarquee.astro";
import Education from "../../../components/sections/Education.astro";
import { SITE_BY_LANG, type Locale } from "../../../i18n/content";

export function getStaticPaths() {
  return [
    { params: { lang: "es", view: "completo" }, props: { lang: "es" as Locale } },
    { params: { lang: "en", view: "full" }, props: { lang: "en" as Locale } },
  ];
}
const { lang } = Astro.props;
const content = SITE_BY_LANG[lang];
const title = lang === "es" ? "CV · Vista completa" : "CV · Full view";
---
<Layout lang={lang} content={content} currentPath={Astro.url.pathname} pageTitle={title} pageDescription={content.profile.introduction}>
  <div class="mx-auto max-w-6xl px-5 pt-8 sm:px-6 sm:pt-10">
    <ResumeViewPicker lang={lang} view="full" />
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-3xl leading-7 text-slate-300">{content.profile.introduction}</p>
    <a href={`/${lang}/cv`} class="signal-hover mt-5 inline-flex min-h-11 items-center rounded-lg border border-cyan-300/40 px-4 py-2 text-sm font-semibold text-cyan-100">{lang === "es" ? "Ver y descargar CV" : "View and download CV"}</a>
  </div>
  <section id="experience"><Experience content={content.experience} /></section>
  <div class="border-y border-white/10 bg-slate-900/40"><TechnologyMarquee content={content.skills} /></div>
  <section id="skills" class="section-alt"><Skills content={content.skills} /></section>
  <section id="projects"><Projects content={content.projects} lang={lang} full embedded /></section>
  <section id="education" class="section-alt"><Education content={content.education} /></section>
</Layout>
