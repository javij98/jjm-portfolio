---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/sections/Hero.astro";
import About from "../../components/sections/About.astro";
import CvProjectsPreview from "../../components/sections/CvProjectsPreview.astro";
import BlogPreview from "../../components/sections/BlogPreview.astro";
import { BLOG_ENABLED } from "../../config/site";
import Contact from "../../components/sections/Contact.astro";
import { LOCALES, SITE_BY_LANG, isLocale, type Locale } from "../../i18n/content";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "es";
if (!isLocale(langParam)) throw new Error(`Unsupported locale: ${langParam}`);

const lang: Locale = langParam;
const content = SITE_BY_LANG[lang];
---

<Layout lang={lang} content={content} currentPath={Astro.url.pathname}>
  <section id="hero"><Hero lang={lang} profile={content.profile} hero={content.hero} /></section>
  <section id="about" class="section-alt"><About content={content.about} /></section>
  <section id="cv-projects"><CvProjectsPreview lang={lang} content={content} /></section>
  {BLOG_ENABLED && <section id="blog" class="section-alt"><BlogPreview lang={lang} /></section>}
  <section id="contact"><Contact profile={content.profile} content={content.contact} /></section>
  <noscript>
    <nav class="mx-auto max-w-6xl space-y-2 px-5 pb-6 text-sm text-cyan-200" aria-label={lang === "es" ? "Secciones trasladadas" : "Moved sections"}>
      {(["projects", "experience", "skills", "education"] as const).map((id) => <p id={id}><a href={`/${lang}/cv#${id}`}>{content.nav[id]}</a></p>)}
    </nav>
  </noscript>
</Layout>

<script>
  const moved = /^(projects|experience|skills|education|work-case-dialog-\d+|project-dialog-\d+)$/;
  const redirectMovedFragment = () => {
    const fragment = window.location.hash.slice(1);
    if (!moved.test(fragment)) return;
    const lang = document.documentElement.lang === "en" ? "en" : "es";
    window.location.replace(`/${lang}/cv#${fragment}`);
  };
  redirectMovedFragment();
  window.addEventListener("hashchange", redirectMovedFragment);
</script>
