---
import Layout from "../../../layouts/Layout.astro";
import { BLOG_ENABLED } from "../../../config/site";
import { BLOG_POSTS } from "../../../data/blog";
import { LOCALES, SITE_BY_LANG, isLocale, type Locale } from "../../../i18n/content";
export function getStaticPaths() {
  return BLOG_ENABLED ? LOCALES.flatMap((lang) => BLOG_POSTS.map((post) => ({ params: { lang, slug: post.slug }, props: { post } }))) : [];
}
const langParam = Astro.params.lang ?? "es";
if (!isLocale(langParam)) throw new Error(`Unsupported locale: ${langParam}`);
const lang: Locale = langParam;
const content = SITE_BY_LANG[lang];
const { post } = Astro.props;
---

<Layout lang={lang} content={content} currentPath={Astro.url.pathname} pageTitle={post.content[lang].title} pageDescription={post.content[lang].excerpt} article>
  <article class="mx-auto max-w-3xl px-5 py-18 sm:px-6 sm:py-24">
    <a href={`/${lang}/blog`} class="signal-hover inline-flex rounded-md border-b border-cyan-400/40 px-2 pb-1 font-mono text-xs text-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">← {lang === "es" ? "Volver al blog" : "Back to blog"}</a>
    <p class="mt-16 font-mono text-xs uppercase tracking-[0.18em] text-emerald-300">{post.category[lang]}</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">{post.content[lang].title}</h1>
    <p class="mt-6 text-lg leading-8 text-slate-300">{post.content[lang].excerpt}</p>
    <div class="mt-12 space-y-7 border-t border-white/12 pt-10">
      {post.content[lang].paragraphs.map((paragraph) => <p class="text-base leading-8 text-slate-200">{paragraph}</p>)}
    </div>
  </article>
</Layout>
