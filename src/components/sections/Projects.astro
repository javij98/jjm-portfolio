---
import type { Locale, ProjectCategory, SiteContent } from "../../i18n/content";
import { HOME_PROJECT_PREVIEW_LIMIT } from "../../config/site";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  content: SiteContent["projects"];
  lang: Locale;
  full?: boolean;
}

const { content, lang, full = false } = Astro.props;
const projects = full ? content.items : content.items.slice(0, HOME_PROJECT_PREVIEW_LIMIT);
const categories: ("all" | ProjectCategory)[] = ["all", "product", "platform", "automation", "web"];
const coverByVisual: Record<string, string> = {
  MF: "/images/projects/moneyflow.svg",
  KB: "/images/projects/knowledge-platform.svg",
  PS: "/images/projects/print-studio.svg",
  HA: "/images/projects/hermes-agent.svg",
  JJM: "/images/projects/personal-portfolio.svg",
  "ES/EN": "/images/projects/services-site.svg",
};
const categoryCount = (category: "all" | ProjectCategory) =>
  category === "all" ? content.items.length : content.items.filter((item) => item.category === category).length;
---

<div class:list={["mx-auto max-w-6xl px-5 sm:px-6", full ? "pb-18 pt-8 sm:pb-24 sm:pt-10" : "py-18 sm:py-24"]}>
  <SectionHeading eyebrow={content.eyebrow} title={content.title} description={content.introduction} />
  {full && (
    <div class="gallery-filters mb-8 flex flex-wrap gap-2" data-project-filters hidden role="group" aria-label={content.filterLabel}>
      {categories.map((category) => (
        <button type="button" class="gallery-filter" data-project-filter={category} aria-pressed={category === "all" ? "true" : "false"}>
          {content.filters[category]} <span class="ml-1 font-mono text-xs opacity-65">{categoryCount(category)}</span>
        </button>
      ))}
    </div>
  )}
  <div class="project-gallery" data-project-gallery>
    {projects.map((project, index) => (
      <article class="gallery-card ambient-hover" data-project-category={project.category} data-reveal>
        <div class="gallery-art" aria-hidden="true">
          <span class="gallery-art-index">{String(index + 1).padStart(2, "0")} / {String(content.items.length).padStart(2, "0")}</span>
          {coverByVisual[project.visual] ? (
            <img class="gallery-cover" src={coverByVisual[project.visual]} alt="" width="800" height="450" loading={full ? "lazy" : "eager"} decoding="async" />
          ) : <span class="gallery-mark">{project.visual}</span>}
          <span class="gallery-art-line"></span>
        </div>
        <div class="gallery-body">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-emerald-300">{project.kind}</p>
          <h3 class="mt-3 text-xl font-semibold tracking-tight text-white">{project.name}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-300">{project.description}</p>
          <button type="button" class="project-details-trigger mt-4 inline-flex min-h-11 items-center self-start font-mono text-xs text-cyan-200 underline-offset-4 hover:text-cyan-100 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300" data-project-open aria-haspopup="dialog" aria-controls={`project-dialog-${index}`}>
            {content.detailsLabel}<span aria-hidden="true" class="ml-1">↗</span>
          </button>
          <ul class="mt-auto flex flex-wrap gap-x-2 gap-y-1 pt-6 font-mono text-[11px] text-slate-400" aria-label={content.stackLabel}>
            {project.stack.map((technology, techIndex) => <li>{techIndex > 0 && <span aria-hidden="true" class="mr-2 text-slate-600">·</span>}{technology}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
  {projects.map((project, index) => (
    <dialog id={`project-dialog-${index}`} class="project-dialog" data-project-dialog aria-labelledby={`project-dialog-title-${index}`} aria-describedby={`project-dialog-description-${index}`}>
      <div class="project-dialog-header">
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-emerald-300">{project.kind}</span>
        <button type="button" class="project-dialog-close" data-project-close aria-label={content.closeLabel}>
          <span aria-hidden="true">×</span><span>{content.closeLabel}</span>
        </button>
      </div>
      <div class="project-dialog-cover" aria-hidden="true">
        {coverByVisual[project.visual] ? <img src={coverByVisual[project.visual]} alt="" width="800" height="450" loading="lazy" decoding="async" /> : <span class="gallery-mark">{project.visual}</span>}
      </div>
      <div class="project-dialog-content">
        <h2 id={`project-dialog-title-${index}`} class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{project.name}</h2>
        <p id={`project-dialog-description-${index}`} class="mt-4 leading-7 text-slate-200">{project.description}</p>
        <div class="mt-5 space-y-3 text-sm leading-7 text-slate-300">
          {project.detailParagraphs.map((paragraph) => <p data-project-detail>{paragraph}</p>)}
        </div>
        <div class="mt-8 border-t border-white/10 pt-6">
          <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-emerald-300">{content.highlightLabel}</h3>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {project.highlights.map((highlight) => <li class="flex gap-3 text-sm leading-6 text-slate-200"><span aria-hidden="true" class="text-emerald-300">→</span><span>{highlight}</span></li>)}
          </ul>
        </div>
        <div class="mt-8 border-t border-white/10 pt-6">
          <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-emerald-300">{content.stackLabel}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.stack.map((technology) => <li class="rounded-md border border-cyan-300/20 bg-cyan-300/5 px-2.5 py-1 font-mono text-xs text-cyan-100">{technology}</li>)}
          </ul>
        </div>
      </div>
    </dialog>
  ))}
  {!full && content.items.length > HOME_PROJECT_PREVIEW_LIMIT && (
    <a href={`/${lang}/projects`} class="signal-hover mt-9 inline-flex min-h-11 items-center rounded-lg border border-cyan-300/40 px-5 py-2.5 text-sm font-semibold text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
      {content.viewAllLabel}<span aria-hidden="true" class="ml-3">↗</span>
    </a>
  )}
</div>

<script>
  document.querySelectorAll<HTMLDialogElement>("[data-project-dialog]").forEach((dialog) => {
    const opener = document.querySelector<HTMLButtonElement>(`[aria-controls="${dialog.id}"]`);
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-project-close]");
    opener?.addEventListener("click", () => {
      const scrollbarWidth = Math.max(0, window.innerWidth - document.documentElement.clientWidth);
      document.documentElement.style.setProperty("--project-dialog-scrollbar", `${scrollbarWidth}px`);
      dialog.showModal();
      document.documentElement.classList.add("project-dialog-open");
      closeButton?.focus();
    });
    closeButton?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("project-dialog-open");
      opener?.focus();
    });
  });

  const filters = document.querySelector<HTMLElement>("[data-project-filters]");
  const buttons = [...(filters?.querySelectorAll<HTMLButtonElement>("[data-project-filter]") ?? [])];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-project-category]")];
  if (filters && buttons.length && cards.length) {
    filters.hidden = false;
    buttons.forEach((button) => button.addEventListener("click", () => {
      const category = button.dataset.projectFilter;
      buttons.forEach((option) => option.setAttribute("aria-pressed", String(option === button)));
      cards.forEach((card) => {
        card.hidden = category !== "all" && card.dataset.projectCategory !== category;
      });
    }));
  }
</script>
