---
import type { SiteContent } from "../../i18n/content";
import SignalTopology from "./SignalTopology.astro";

interface Props {
  profile: SiteContent["profile"];
  hero: SiteContent["hero"];
}

const { profile, hero } = Astro.props;
---

<div class="hero-shell relative isolate" data-hero-interactive>
  <SignalTopology variant="hero" />
  <div class="hero-pointer-field pointer-events-none absolute inset-0" data-hero-pointer-field aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-8 sm:px-6 sm:pb-24 sm:pt-20 lg:pt-24">
    <div class="relative z-10" data-reveal>
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-emerald-300">{hero.eyebrow}</p>
      <h1 class="mt-3 whitespace-nowrap text-[clamp(1.625rem,8.2vw,2.5rem)] font-bold leading-[1.05] tracking-tight text-white sm:mt-4 sm:text-[clamp(2.5rem,5.2vw,4.8rem)]">
        {profile.name}
      </h1>
    </div>
    <div class="mt-4 grid items-center gap-5 sm:mt-6 sm:gap-7 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <div class="relative z-10" data-reveal>
        <p class="text-2xl font-semibold tracking-tight text-cyan-300 sm:text-3xl">{profile.role}</p>
        <p class="mt-1 text-sm font-medium text-emerald-200 sm:mt-2">{profile.direction}</p>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300 sm:hidden">{hero.mobileIntroduction}</p>
        <p class="mt-7 hidden max-w-2xl text-base leading-7 text-slate-300 sm:block sm:text-lg sm:leading-8">{profile.introduction}</p>
        <div class="mt-8 hidden sm:block">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400">{hero.focus}</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            {hero.focusAreas.map((area) => <li class="border-b border-cyan-400/40 pb-1 font-mono text-xs text-cyan-100">{area}</li>)}
          </ul>
        </div>
        <div class="mt-5 flex flex-wrap gap-3 sm:mt-9">
          <a href="#projects" class="signal-hover inline-flex min-h-11 items-center justify-center rounded-lg border border-emerald-300 bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300">
            {hero.projectsCta}<span aria-hidden="true" class="ml-2">↗</span>
          </a>
          <a href="#contact" class="signal-hover inline-flex min-h-11 items-center justify-center rounded-lg border border-white/20 px-5 py-2.5 text-sm font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
            {hero.contactCta}
          </a>
        </div>
      </div>
      <div class="relative z-10 overflow-hidden rounded-2xl border border-white/12 bg-slate-900/80 shadow-2xl shadow-black/20" data-reveal data-terminal>
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-3 sm:py-4">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-400/75"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-400/75"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/75"></span>
          </div>
          <span class="font-mono text-[11px] text-slate-400">{hero.terminalTitle}</span>
        </div>
        <div class="px-5 py-5 font-mono text-xs leading-6 sm:px-7 sm:py-8 sm:text-sm">
          <p class="break-all text-cyan-300"><span aria-hidden="true" class="mr-2 text-emerald-300">❯</span><span class="sr-only">{hero.terminalPrompt}</span><span aria-hidden="true" data-typed-command data-text={hero.terminalPrompt}>{hero.terminalPrompt}</span><span class="terminal-cursor" aria-hidden="true">_</span></p>
          <ul class="mt-4 space-y-2 border-l border-emerald-400/35 pl-4 text-slate-200 sm:hidden">
            {hero.terminalMobileLines.map((line) => <li data-terminal-line>{line}</li>)}
          </ul>
          <ul class="mt-5 hidden space-y-3 border-l border-emerald-400/35 pl-4 text-slate-200 sm:block">
            {hero.terminalLines.map((line) => <li data-terminal-line>{line}</li>)}
          </ul>
          <p class="mt-4 text-emerald-300 sm:mt-6" aria-hidden="true">❯</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const terminal = document.querySelector<HTMLElement>("[data-terminal]");
  const command = terminal?.querySelector<HTMLElement>("[data-typed-command]");
  const lines = [...(terminal?.querySelectorAll<HTMLElement>("[data-terminal-line]") ?? [])]
    .filter((line) => line.getClientRects().length > 0);
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (terminal && command && !reduced) {
    const fullText = command.dataset.text ?? "";
    command.textContent = "";
    lines.forEach((line) => line.classList.add("terminal-line-pending"));
    let position = 0;
    const typeNext = () => {
      if (!command.isConnected) return;
      command.textContent = fullText.slice(0, ++position);
      if (position < fullText.length) {
        window.setTimeout(typeNext, 20);
      } else {
        lines.forEach((line, index) => window.setTimeout(() => line.classList.remove("terminal-line-pending"), 100 + index * 190));
      }
    };
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        window.setTimeout(typeNext, 100);
      }, { threshold: 0.15 });
      observer.observe(terminal);
    } else {
      window.setTimeout(typeNext, 100);
    }
  }
  const heroSurface = document.querySelector<HTMLElement>("[data-hero-interactive]");
  if (heroSurface && window.matchMedia("(hover: hover) and (pointer: fine)").matches && !reduced) {
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let frame = 0;
    let active = false;

    const followPointer = () => {
      currentX += (targetX - currentX) * 0.18;
      currentY += (targetY - currentY) * 0.18;
      heroSurface.style.setProperty("--hero-pointer-x", `${currentX}px`);
      heroSurface.style.setProperty("--hero-pointer-y", `${currentY}px`);
      if (Math.abs(targetX - currentX) > 0.3 || Math.abs(targetY - currentY) > 0.3) {
        frame = window.requestAnimationFrame(followPointer);
      } else {
        frame = 0;
      }
    };

    heroSurface.addEventListener("pointermove", (event) => {
      const bounds = heroSurface.getBoundingClientRect();
      targetX = Math.max(0, Math.min(bounds.width, event.clientX - bounds.left));
      targetY = Math.max(0, Math.min(bounds.height, event.clientY - bounds.top));
      if (!active) {
        currentX = targetX;
        currentY = targetY;
        active = true;
      }
      heroSurface.classList.add("is-pointer-active");
      if (!frame) frame = window.requestAnimationFrame(followPointer);
    }, { passive: true });

    heroSurface.addEventListener("pointerleave", () => {
      heroSurface.classList.remove("is-pointer-active");
      active = false;
      window.cancelAnimationFrame(frame);
      frame = 0;
    });
  }
  if (heroSurface && window.matchMedia("(pointer: coarse)").matches && !reduced) {
    let touchPointerId = -1;
    let fadeTimer = 0;
    const placeGlow = (event: PointerEvent) => {
      const bounds = heroSurface.getBoundingClientRect();
      heroSurface.style.setProperty("--hero-pointer-x", `${event.clientX - bounds.left}px`);
      heroSurface.style.setProperty("--hero-pointer-y", `${event.clientY - bounds.top}px`);
    };
    heroSurface.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "touch") return;
      window.clearTimeout(fadeTimer);
      touchPointerId = event.pointerId;
      placeGlow(event);
      heroSurface.classList.add("is-pointer-active");
    }, { passive: true });
    heroSurface.addEventListener("pointermove", (event) => {
      if (event.pointerId === touchPointerId) placeGlow(event);
    }, { passive: true });
    const releaseGlow = (event: PointerEvent) => {
      if (event.pointerId !== touchPointerId) return;
      touchPointerId = -1;
      fadeTimer = window.setTimeout(() => heroSurface.classList.remove("is-pointer-active"), 420);
    };
    window.addEventListener("pointerup", releaseGlow, { passive: true });
    window.addEventListener("pointercancel", releaseGlow, { passive: true });
  }
</script>
