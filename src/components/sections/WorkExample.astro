---
import type { SiteContent, WorkExample } from "../../i18n/content";
import WorkExampleContent from "./WorkExampleContent.astro";

interface Props {
  example: WorkExample;
  index: number;
  labels: SiteContent["experience"]["exampleLabels"];
}

const { example, index, labels } = Astro.props;
---

<article class="work-example ambient-hover -mx-3 grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 gap-y-2 px-3 py-6 sm:-mx-4 sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:gap-x-6 sm:px-4">
  <span class="pt-1 font-mono text-sm text-slate-500" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <div class="min-w-0">
    <h4 id={`work-case-title-${index}`} class="text-lg font-semibold leading-7 text-white">{example.title}</h4>
    <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-300">{example.description}</p>
  </div>
  <button type="button" class="work-case-details col-start-2 inline-flex min-h-11 items-center justify-self-start self-center font-mono text-xs text-cyan-200 underline-offset-4 hover:text-cyan-100 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300 sm:col-start-3 sm:row-start-1" data-work-case-open hidden aria-haspopup="dialog" aria-controls={`work-case-dialog-${index}`} aria-labelledby={`work-case-details-${index} work-case-title-${index}`}>
    <span id={`work-case-details-${index}`}>{labels.details}</span><span aria-hidden="true" class="ml-2">↗</span>
  </button>
  <noscript class="col-span-full min-w-0 sm:col-span-2 sm:col-start-2">
    <div class="mt-5"><WorkExampleContent example={example} labels={labels} /></div>
  </noscript>
</article>

<style>
  .work-case-details[hidden] { display: none; }
</style>
