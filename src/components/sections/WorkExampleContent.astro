---
import type { SiteContent, WorkExample } from "../../i18n/content";

interface Props {
  example: WorkExample;
  labels: SiteContent["experience"]["exampleLabels"];
}

const { example, labels } = Astro.props;
---

<p class="mb-6 font-mono text-xs leading-5 text-amber-200">{example.status}</p>
<dl class="space-y-6 text-sm leading-7 text-slate-300">
  <div>
    <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-slate-400">{labels.problem}</dt>
    <dd class="mt-2">{example.problem}</dd>
  </div>
  <div>
    <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-cyan-200">{labels.solution}</dt>
    <dd class="mt-2">{example.solution}</dd>
  </div>
  <div class="border-l border-emerald-300/40 pl-4">
    <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-emerald-300">{labels.impact}</dt>
    <dd class="mt-2 text-slate-200">{example.impact}</dd>
  </div>
</dl>
{example.metric && (
  <div class="mt-7 rounded-lg border border-emerald-300/20 bg-emerald-300/5 p-5" data-work-metric={example.metric.kind}>
    <p class="text-2xl font-semibold tracking-tight text-emerald-200">{example.metric.value}</p>
    <p class="mt-2 text-sm font-medium text-emerald-100">{example.metric.label}</p>
    {example.metric.note && <p class="mt-3 text-xs leading-6 text-slate-400">{example.metric.note}</p>}
  </div>
)}
<div class="mt-7 border-t border-white/10 pt-6">
  <h3 class="font-mono text-[11px] uppercase tracking-[0.14em] text-emerald-300">{labels.stack}</h3>
  <ul class="mt-4 flex flex-wrap gap-2">
    {example.stack.map((technology) => (
      <li class="rounded-md border border-cyan-300/20 bg-cyan-300/5 px-2.5 py-1 font-mono text-xs text-cyan-100">{technology}</li>
    ))}
  </ul>
</div>
