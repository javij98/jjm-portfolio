---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  tag?: "h1" | "h2";
}

const { eyebrow, title, description, tag = "h2" } = Astro.props;
const Heading = tag;
---

<div class="mb-9 max-w-2xl sm:mb-12" data-reveal>
  <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-emerald-300">
    <span aria-hidden="true" class="mr-2 text-cyan-400">//</span>{eyebrow}
  </p>
  <Heading class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</Heading>
  {description && <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-300">{description}</p>}
</div>
