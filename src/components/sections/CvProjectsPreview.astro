---
import type { Locale, SiteContent } from "../../i18n/content";
import SectionHeading from "./SectionHeading.astro";
import { CV_PREVIEW } from "../../data/cv-preview";
import { PROJECT_COVERS } from "../../data/project-covers";

interface Props { lang: Locale; content: SiteContent; }
const { lang, content } = Astro.props;
const copy = CV_PREVIEW[lang];
---

<div class="mx-auto max-w-6xl px-5 py-18 sm:px-6 sm:py-24">
  <SectionHeading
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
  />
  <div class="mb-8 grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)] lg:gap-6">
    <div class="flex min-w-0 flex-col" data-reveal>
      <h3 class="mb-4 text-lg font-semibold text-white">{content.experience.title}</h3>
      <div class="flex flex-1 flex-col rounded-xl border border-white/10 bg-slate-900/70 p-5 sm:p-6">
        <div class="relative flex-1 pl-5 before:absolute before:bottom-0 before:left-[3px] before:top-2 before:w-px before:bg-gradient-to-b before:from-emerald-300/70 before:via-cyan-300/30 before:to-transparent" data-home-experience>
          {content.experience.items.slice(0, 2).map((item, index) => (
            <article class:list={["relative", index === 0 ? "pb-6" : "pb-3"]} data-home-experience-item>
              <span class="absolute -left-5 top-1.5 h-[7px] w-[7px] rounded-full bg-emerald-300" aria-hidden="true"></span>
              <p class="font-mono text-[11px] text-emerald-300">{item.period}</p>
              <h4 class="mt-2 text-lg font-semibold text-white" data-home-experience-company>{item.company}</h4>
              <p class="mt-1 text-sm font-medium text-cyan-200" data-home-experience-role>{item.role}</p>
              <p class:list={["mt-3 text-sm leading-6 text-slate-300", index > 0 && "line-clamp-2 text-slate-400"]} data-home-experience-summary>{item.summary}</p>
            </article>
          ))}
          <span class="block font-mono text-lg tracking-[0.18em] text-slate-500" aria-hidden="true">···</span>
        </div>
        <a href={`/${lang}/cv#experience`} data-home-experience-more class="mt-5 inline-flex min-h-11 items-center self-start font-mono text-xs font-semibold text-cyan-200 underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{copy.experienceMore}<span aria-hidden="true" class="ml-2">↗</span></a>
      </div>
    </div>
    <div class="flex min-w-0 flex-col" data-reveal>
      <h3 class="mb-4 text-lg font-semibold text-white">{content.projects.title}</h3>
      <div class="grid flex-1 gap-4 sm:grid-cols-2">
        {content.projects.items.slice(0, 2).map((project) => (
          <a href={`/${lang}/cv#projects`} data-home-project-card class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-white/10 bg-slate-900/70 transition-colors hover:border-emerald-300/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300">
            <div class="h-28 overflow-hidden bg-slate-900 sm:h-36" aria-hidden="true">
              {PROJECT_COVERS[project.visual] && <img src={PROJECT_COVERS[project.visual]} alt="" width="800" height="450" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:transform-none" />}
            </div>
            <div class="flex flex-1 flex-col p-4 sm:p-5">
              <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-emerald-300">{project.kind}</p>
              <h4 class="mt-2 text-base font-semibold text-white sm:text-lg">{project.name}<span aria-hidden="true" class="ml-2 text-cyan-300">↗</span></h4>
              <p class="mt-3 text-sm leading-6 text-slate-300" data-home-project-description>{project.description}</p>
              <p class="mt-auto pt-4 text-xs leading-5 text-slate-400">{project.stack.slice(0, 3).join(" · ")}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="flex flex-wrap gap-3" data-reveal>
    <a href={`/${lang}/cv`} class="signal-hover inline-flex min-h-11 items-center justify-center rounded-lg border border-emerald-300 bg-emerald-400 px-5 py-2.5 text-sm font-semibold text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300">{copy.cv}<span aria-hidden="true" class="ml-2">↗</span></a>
    <a href={`/${lang}/cv#projects`} class="signal-hover inline-flex min-h-11 items-center justify-center rounded-lg border border-cyan-300/40 px-5 py-2.5 text-sm font-semibold text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{copy.projects}<span aria-hidden="true" class="ml-2">↗</span></a>
  </div>
</div>
