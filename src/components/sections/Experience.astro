---
import type { SiteContent } from "../../i18n/content";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  content: SiteContent["experience"];
}

const { content } = Astro.props;
---

<div class="mx-auto max-w-6xl px-5 py-18 sm:px-6 sm:py-24">
  <SectionHeading eyebrow={content.eyebrow} title={content.title} description={content.introduction} />
  <div class="experience-line ml-3 border-l border-white/15 pl-7 sm:ml-5 sm:pl-10">
    {content.items.map((item) => (
      <article class="experience-entry ambient-hover relative pb-12 last:pb-2" data-reveal>
        <span class:list={["experience-node absolute -left-[2.25rem] top-2 h-4 w-4 rounded-full border-2 bg-slate-950 sm:-left-[3rem]", item.current ? "border-emerald-300" : "border-cyan-300"]} aria-hidden="true"></span>
        <div class="grid gap-5 border-b border-white/10 pb-9 lg:grid-cols-[minmax(0,0.3fr)_minmax(0,0.7fr)] lg:gap-12">
          <div>
            <p class="font-mono text-xs text-emerald-300">{item.period}</p>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <h3 class="text-2xl font-bold text-white">{item.company}</h3>
              {item.current && <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-300">{content.currentLabel}</span>}
            </div>
            <p class="mt-1 font-medium text-cyan-200">{item.role}</p>
          </div>
          <div>
            <p class="max-w-2xl leading-7 text-slate-300">{item.summary}</p>
            {item.evolution && (
              <div class="mt-6">
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-400">{content.evolutionLabel}</p>
                <ol class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-xs text-cyan-100">
                  {item.evolution.map((stage, index) => <li>{index > 0 && <span class="mr-2 text-emerald-400" aria-hidden="true">→</span>}{stage}</li>)}
                </ol>
              </div>
            )}
            <ul class="mt-6 space-y-3">
              {item.achievements.map((achievement) => (
                <li class="flex gap-3 text-sm leading-6 text-slate-200">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-300"></span>
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-14 border-t border-white/10 pt-9" data-reveal>
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-emerald-300">{content.examplesEyebrow}</p>
    <h3 class="mt-2 text-2xl font-semibold text-white">{content.examplesTitle}</h3>
    <p class="mt-3 max-w-2xl leading-7 text-slate-300">{content.examplesIntroduction}</p>
  </div>
  <div class="mt-5 divide-y divide-white/10">
    {content.examples.map((example, index) => (
      <article class="work-example ambient-hover grid gap-3 py-6 sm:grid-cols-[3rem_minmax(0,0.38fr)_minmax(0,0.62fr)] sm:gap-6" data-reveal>
        <span class="font-mono text-sm text-slate-500">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h4 class="text-lg font-semibold text-white">{example.title}</h4>
          <p class="mt-2 font-mono text-xs text-amber-200">{example.status}</p>
        </div>
        <p class="text-sm leading-7 text-slate-300">{example.description}</p>
      </article>
    ))}
  </div>
</div>
