---
import type { Locale } from "../../i18n/content";
import { BLOG_POSTS } from "../../data/blog";
import SectionHeading from "./SectionHeading.astro";

interface Props { lang: Locale; full?: boolean; }
const { lang, full = false } = Astro.props;
const isEs = lang === "es";
const posts = full ? BLOG_POSTS : BLOG_POSTS.slice(0, 2);
---

<div class:list={["mx-auto max-w-6xl px-5 sm:px-6", full ? "pb-18 pt-8 sm:pb-24 sm:pt-10" : "py-18 sm:py-24"]}>
  <SectionHeading
    eyebrow={isEs ? "Notas de ingeniería" : "Engineering notes"}
    title="Blog"
    description={isEs ? "Apuntes sobre desarrollo, plataformas y lo que voy aprendiendo." : "Notes on software, platforms and what I am learning along the way."}
  />
  <div class="grid gap-5 md:grid-cols-2">
    {posts.map((post, index) => (
      <a href={`/${lang}/blog/${post.slug}`} class="blog-card signal-hover group flex min-h-60 flex-col rounded-2xl border border-white/10 bg-slate-900/20 px-6 py-7 sm:px-8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300" data-reveal>
        <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.16em] text-emerald-300">
          <span>{post.category[lang]}</span><span class="text-slate-500">{String(index + 1).padStart(2, "0")}</span>
        </div>
        <h3 class="mt-7 max-w-lg text-2xl font-semibold tracking-tight text-white">{post.content[lang].title}</h3>
        <p class="mt-3 max-w-lg text-sm leading-7 text-slate-300">{post.content[lang].excerpt}</p>
        <span class="mt-auto pt-6 font-mono text-xs text-cyan-200">{isEs ? "Leer nota" : "Read note"} <span aria-hidden="true">↗</span></span>
      </a>
    ))}
  </div>
  {!full && <a href={`/${lang}/blog`} class="signal-hover mt-8 inline-flex min-h-11 items-center rounded-lg border border-cyan-300/40 px-5 py-2.5 text-sm font-semibold text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{isEs ? "Ver todo el blog" : "View all posts"}<span aria-hidden="true" class="ml-3">↗</span></a>}
</div>
