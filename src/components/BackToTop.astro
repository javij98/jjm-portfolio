---
import type { Locale } from "../i18n/content";
interface Props { lang: Locale; }
const { lang } = Astro.props;
const label = lang === "es" ? "Volver arriba" : "Back to top";
---
<button
  type="button"
  data-back-to-top
  hidden
  aria-label={label}
  title={label}
  class="fixed bottom-4 right-4 z-40 flex h-11 w-11 items-center justify-center rounded-full border border-cyan-300/40 bg-slate-900/95 text-cyan-100 shadow-lg shadow-slate-950/40 hover:border-cyan-200 hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7M12 5v14" /></svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  if (button) {
    const update = () => { button.hidden = window.scrollY < 300; };
    window.addEventListener("scroll", update, { passive: true });
    update();
    button.addEventListener("click", (event) => {
      if (event.detail === 0) document.querySelector<HTMLElement>("#main-content")?.focus({ preventScroll: true });
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduced ? "instant" : "smooth" });
    });
  }
</script>

<style>
  [data-back-to-top][hidden] { display: none; }
  [data-back-to-top] { bottom: max(1rem, env(safe-area-inset-bottom)); right: max(1rem, env(safe-area-inset-right)); }
</style>
