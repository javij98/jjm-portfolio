---
import type { Locale } from "../i18n/content";

interface Props {
  lang: Locale;
  mode: "human" | "llm";
  isCv?: boolean;
}

const { lang, mode, isCv = false } = Astro.props;
const modes = [
  { value: "human", label: "Human", href: isCv ? `/${lang}/cv` : `/${lang}`, description: isCv ? (lang === "es" ? "Ver el CV visual · Human mode" : "View the visual CV · Human mode") : (lang === "es" ? "Ver la web visual · Human mode" : "View the visual website · Human mode") },
  { value: "llm", label: "LLM", href: isCv ? `/${lang}/cv/llm` : `/${lang}/llm`, description: isCv ? (lang === "es" ? "Ver el CV en Markdown · LLM mode" : "View the CV as Markdown · LLM mode") : (lang === "es" ? "Ver toda la web en Markdown · LLM mode" : "View the whole website as Markdown · LLM mode") },
];
---

<div data-mode-picker role="group" class="inline-flex h-9 w-[94px] min-[375px]:w-28 shrink-0 items-center justify-center gap-0 min-[375px]:gap-1 rounded-md border border-white/15 bg-slate-900/60 px-1 min-[375px]:px-2 font-mono text-xs" aria-label={lang === "es" ? "Modo de lectura" : "Reading mode"}>
  {modes.map((item, index) => (
    <>
      {index > 0 && <span aria-hidden="true" class="text-slate-600">/</span>}
      <a
        href={item.href}
        data-view-mode={item.value}
        aria-current={mode === item.value ? "page" : undefined}
        aria-label={item.description}
        title={item.description}
        class:list={[
          "rounded px-0.5 py-1 min-[375px]:px-1 focus-visible:outline-2 focus-visible:outline-cyan-300",
          mode === item.value ? "text-cyan-200" : "text-slate-400 hover:text-white",
        ]}
      >{item.label}</a>
    </>
  ))}
</div>
