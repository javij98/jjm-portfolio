---
import type { Locale } from "../i18n/content";
interface Props { lang: Locale; view: "compact" | "full"; }
const { lang, view } = Astro.props;
const links = [
  { view: "full", href: `/${lang}/cv`, label: lang === "es" ? "Vista completa" : "Full view" },
  { view: "compact", href: `/${lang}/cv/compact`, label: lang === "es" ? "Vista compacta" : "Compact view" },
];
---
<nav data-cv-view-picker aria-label={lang === "es" ? "Vista del CV" : "CV view"} class="mb-7 flex w-fit flex-wrap gap-1 rounded-lg border border-white/15 bg-slate-900/60 p-1 text-sm">
  {links.map((item) => <a href={item.href} data-cv-view={item.view} aria-current={view === item.view ? "page" : undefined} class:list={["rounded-md px-3 py-2 font-medium focus-visible:outline-2 focus-visible:outline-cyan-300", view === item.view ? "bg-cyan-300/15 text-cyan-100" : "text-slate-400 hover:text-white"]}>{item.label}</a>)}
</nav>

<script>
  const picker = document.querySelector<HTMLElement>("[data-cv-view-picker]");
  const panels = [...document.querySelectorAll<HTMLElement>("[data-cv-panel]")];
  const links = [...(picker?.querySelectorAll<HTMLAnchorElement>("[data-cv-view]") ?? [])];
  const setView = (compact: boolean) => {
    const view = compact ? "compact" : "full";
    panels.forEach((panel) => { panel.hidden = panel.dataset.cvPanel !== view; });
    links.forEach((link) => {
      const active = link.dataset.cvView === view;
      if (active) link.setAttribute("aria-current", "page"); else link.removeAttribute("aria-current");
      link.classList.toggle("bg-cyan-300/15", active);
      link.classList.toggle("text-cyan-100", active);
      link.classList.toggle("text-slate-400", !active);
      link.classList.toggle("hover:text-white", !active);
    });
    const suffix = compact ? "/cv/compact" : "/cv";
    const lang = document.documentElement.lang === "en" ? "en" : "es";
    document.querySelectorAll<HTMLAnchorElement>("[data-language-picker] a[lang]").forEach((link) => { link.href = `/${link.lang}${suffix}`; });
    document.querySelectorAll<HTMLLinkElement>('link[rel="alternate"][hreflang]').forEach((link) => {
      const locale = link.hreflang === "en" ? "en" : "es";
      link.href = new URL(`/${locale}${suffix}`, link.href).href;
    });
    const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
    if (canonical) {
      canonical.href = new URL(`/${lang}${suffix}`, canonical.href).href;
      document.querySelector<HTMLMetaElement>('meta[property="og:url"]')?.setAttribute("content", canonical.href);
    }
    const markdown = document.querySelector<HTMLLinkElement>('link[rel="alternate"][type="text/markdown"]');
    if (markdown) markdown.href = new URL(`/${lang}/cv.md`, markdown.href).href;
    window.dispatchEvent(new Event("cv:view-changed"));
  };
  links.forEach((link) => link.addEventListener("click", (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (window.location.pathname.replace(/\/$/, "") !== link.pathname) history.pushState(null, "", link.href);
    setView(link.dataset.cvView === "compact");
  }));
  window.addEventListener("popstate", () => setView(window.location.pathname.replace(/\/$/, "").endsWith("/compact")));
</script>
